<UserControl
    x:Class="LinkPeek.Windows.GeneralPage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ui:DynamicScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource SettingsPageStyle}">
            <ui:TextBlock FontTypography="Title" Text="General" />
            <ui:TextBlock
                Margin="0,4,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Choose when LinkPeek starts and how hover cards open."
                TextWrapping="Wrap" />

            <ui:InfoBar
                x:Name="Status"
                Margin="0,20,0,0"
                IsClosable="True"
                IsOpen="False" />

            <ui:TextBlock Style="{StaticResource SettingsSectionStyle}" Text="Startup" />
            <ui:CardControl Style="{StaticResource SettingsCardStyle}">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Rocket24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Launch at sign-in" />
                        <ui:TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Start in the system tray when you sign in to Windows." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch
                    x:Name="Startup"
                    AutomationProperties.Name="Launch at sign-in"
                    OffContent="Off"
                    OnContent="On" />
            </ui:CardControl>

            <ui:TextBlock Style="{StaticResource SettingsSectionStyle}" Text="Hover" />
            <ui:CardControl Style="{StaticResource SettingsCardStyle}">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Timer24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Hover delay" />
                        <ui:TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="How long the pointer rests on a link before its card opens." />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBlock
                        x:Name="DelayValue"
                        MinWidth="64"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="500 ms"
                        TextAlignment="Right" />
                    <Slider
                        x:Name="Delay"
                        Width="200"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Hover delay in milliseconds"
                        IsSnapToTickEnabled="True"
                        LargeChange="100"
                        Maximum="1000"
                        Minimum="300"
                        SmallChange="50"
                        TickFrequency="50" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource SettingsCardStyle}">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Keyboard24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Require Alt + hover" />
                        <ui:TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Open cards only while the Alt key is held." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch
                    x:Name="Alt"
                    AutomationProperties.Name="Require Alt + hover"
                    OffContent="Off"
                    OnContent="On" />
            </ui:CardControl>

            <ui:TextBlock Style="{StaticResource SettingsSectionStyle}" Text="Cards" />
            <ui:CardControl Style="{StaticResource SettingsCardStyle}">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="QrCode24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="What appears on hover" />
                        <ui:TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Azure DevOps pull request links show a preview. Other web links become a QR code generated on this device. Cards follow your Windows light or dark theme." />
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>
        </StackPanel>
    </ui:DynamicScrollViewer>
</UserControl>
