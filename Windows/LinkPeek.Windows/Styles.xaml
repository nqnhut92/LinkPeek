<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--  Layout metrics follow the Windows settings pattern used by PowerToys and WinUI Gallery.  -->
    <Style x:Key="SettingsPageStyle" TargetType="StackPanel">
        <Setter Property="MaxWidth" Value="1000" />
        <Setter Property="Margin" Value="36,12,36,36" />
    </Style>
    <Style x:Key="SettingsSectionStyle" TargetType="ui:TextBlock">
        <Setter Property="FontTypography" Value="BodyStrong" />
        <Setter Property="Margin" Value="1,28,0,8" />
    </Style>
    <Style x:Key="SettingsDescriptionStyle" TargetType="ui:TextBlock">
        <Setter Property="FontTypography" Value="Caption" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,24,0" />
    </Style>
    <Style x:Key="SecondaryTextStyle" TargetType="ui:TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
