<ui:FluentWindow
    x:Class="LinkPeek.Windows.OpenLinkWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Open link"
    Width="520"
    MinWidth="0"
    MinHeight="0"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar
            x:Name="LinkTitleBar"
            Title="LinkPeek"
            ShowMaximize="False"
            ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon x:Name="TitleIcon" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <StackPanel Grid.Row="1" Margin="24,4,24,24">
            <ui:TextBlock FontTypography="Subtitle" Text="Open link" />
            <ui:TextBlock
                Margin="0,8,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Paste a complete HTTP or HTTPS URL when an app doesn't expose its link on hover. LinkPeek never reads the clipboard by itself."
                TextWrapping="Wrap" />
            <ui:TextBox
                x:Name="Input"
                AutomationProperties.Name="Link URL"
                PlaceholderText="https://">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Link24" />
                </ui:TextBox.Icon>
            </ui:TextBox>
            <ui:TextBlock
                x:Name="Error"
                Margin="0,8,0,0"
                FontTypography="Caption"
                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                Text="Enter a complete HTTP or HTTPS URL without embedded credentials."
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
        <Border
            Grid.Row="2"
            Padding="24"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button
                    x:Name="Open"
                    HorizontalAlignment="Stretch"
                    Appearance="Primary"
                    Content="Open link"
                    IsDefault="True" />
                <ui:Button
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    Content="Cancel"
                    IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
