<Window
    x:Class="LinkPeek.Windows.CardWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="LinkPeek"
    Width="344"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    FontSize="14"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    SnapsToDevicePixels="True"
    Topmost="True"
    UseLayoutRounding="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">
    <!--
        A popover like the macOS NSPopover: one rounded surface with an arrow that points at the
        hovered link. The outer margin is room for the drop shadow; a 9 px row above and below the card is reserved for the arrow, which is shown on the side facing the link, and CardWindow.Reposition moves it under the pointer.
    -->
    <Grid x:Name="Root" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="9" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="9" />
        </Grid.RowDefinitions>
        <Border
            x:Name="Surface"
            Grid.Row="1"
            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="16"
                    Direction="270"
                    Opacity="0.3"
                    ShadowDepth="2" />
            </Border.Effect>
            <StackPanel Margin="20,14,20,18">
                <Grid MinHeight="20">
                    <ui:TextBlock
                        x:Name="Caption"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:Button
                        x:Name="CloseButton"
                        Width="28"
                        Height="28"
                        Margin="0,-6,-10,-6"
                        Padding="0"
                        HorizontalAlignment="Right"
                        Appearance="Transparent"
                        AutomationProperties.Name="Close card"
                        BorderThickness="0"
                        ToolTip="Close"
                        Visibility="Collapsed">
                        <ui:Button.Icon>
                            <ui:SymbolIcon FontSize="12" Symbol="Dismiss24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
                <ui:TextBlock
                    x:Name="Heading"
                    Margin="0,6,0,0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap" />
                <StackPanel x:Name="Details" Margin="0,6,0,0" />
                <Border
                    x:Name="QrFrame"
                    Margin="0,12,0,0"
                    Padding="6"
                    HorizontalAlignment="Center"
                    Background="White"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
                    <Image
                        x:Name="Qr"
                        AutomationProperties.Name="QR code for this link"
                        RenderOptions.EdgeMode="Aliased"
                        Stretch="None" />
                </Border>
                <ui:TextBlock
                    x:Name="StatusText"
                    Margin="0,10,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <ui:InfoBar
                    x:Name="Notice"
                    Margin="0,10,0,0"
                    IsClosable="False"
                    IsOpen="False" />
                <WrapPanel x:Name="Actions" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
        <!-- Open figures: only the two slanted edges are stroked, so the base blends into the surface. -->
        <Path
            x:Name="ArrowTop"
            Grid.Row="0"
            Width="18"
            Height="9"
            Margin="0,0,0,-1"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Panel.ZIndex="1"
            Data="M0,9 L9,0 L18,9"
            Fill="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
            Stroke="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
            StrokeThickness="1" />
        <Path
            x:Name="ArrowBottom"
            Grid.Row="2"
            Width="18"
            Height="9"
            Margin="0,-1,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Panel.ZIndex="1"
            Data="M0,0 L9,9 L18,0"
            Fill="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
            Stroke="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
            StrokeThickness="1"
            Visibility="Hidden" />
    </Grid>
</Window>
