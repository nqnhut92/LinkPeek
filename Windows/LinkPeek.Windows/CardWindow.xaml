<ui:FluentWindow
    x:Class="LinkPeek.Windows.CardWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="LinkPeek"
    Width="368"
    MinWidth="0"
    MinHeight="0"
    Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Topmost="True"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    WindowStartupLocation="Manual">
    <StackPanel Margin="20,12,12,20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image
                x:Name="Logo"
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                RenderOptions.BitmapScalingMode="HighQuality" />
            <ui:TextBlock
                Grid.Column="1"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                FontTypography="Caption"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="LinkPeek" />
            <ui:Button
                x:Name="CloseButton"
                Grid.Column="2"
                Width="32"
                Height="32"
                Padding="0"
                Appearance="Transparent"
                AutomationProperties.Name="Close card"
                BorderThickness="0"
                ToolTip="Close">
                <ui:Button.Icon>
                    <ui:SymbolIcon FontSize="14" Symbol="Dismiss24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>
        <StackPanel Margin="0,4,8,0">
            <ui:TextBlock
                x:Name="Heading"
                FontTypography="Subtitle"
                TextWrapping="Wrap" />
            <StackPanel x:Name="Details" Margin="0,8,0,0" />
            <Border
                x:Name="QrFrame"
                Margin="0,16,0,0"
                Padding="4"
                HorizontalAlignment="Center"
                Background="White"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <Image
                    x:Name="Qr"
                    AutomationProperties.Name="QR code for this link"
                    RenderOptions.EdgeMode="Aliased"
                    Stretch="None" />
            </Border>
            <ui:TextBlock
                x:Name="StatusText"
                Margin="0,12,0,0"
                FontTypography="Caption"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <ui:InfoBar
                x:Name="Notice"
                Margin="0,12,0,0"
                IsClosable="False"
                IsOpen="False" />
            <WrapPanel x:Name="Actions" Margin="0,12,0,0" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
