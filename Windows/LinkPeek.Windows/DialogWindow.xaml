<ui:FluentWindow
    x:Class="LinkPeek.Windows.DialogWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="LinkPeek"
    Width="460"
    MinWidth="0"
    MinHeight="0"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Topmost="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">
    <!--  Layout mirrors a WinUI ContentDialog: title, body, and a footer band with equal-width buttons.  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar
            x:Name="DialogTitleBar"
            Title="LinkPeek"
            ShowMaximize="False"
            ShowMinimize="False" />
        <StackPanel Grid.Row="1" Margin="24,4,24,24">
            <ui:TextBlock
                x:Name="Heading"
                FontTypography="Subtitle"
                TextWrapping="Wrap" />
            <ui:TextBlock
                x:Name="Message"
                Margin="0,12,0,0"
                TextWrapping="Wrap" />
            <ui:TextBox
                x:Name="LongText"
                MaxHeight="360"
                Margin="0,12,0,0"
                AcceptsReturn="True"
                ClearButtonEnabled="False"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="12"
                HorizontalScrollBarVisibility="Disabled"
                IsReadOnly="True"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed" />
        </StackPanel>
        <Border
            Grid.Row="2"
            Padding="24"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button
                    x:Name="Primary"
                    HorizontalAlignment="Stretch"
                    Appearance="Primary" />
                <ui:Button
                    x:Name="Secondary"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
